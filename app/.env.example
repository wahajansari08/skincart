# SkinCart environment variables — copy to .env.local and fill in locally.
# .env.local is git-ignored. NEVER commit a real key.

# YouCam API key (server-side only). Get it from the YouCam API console:
# https://yce.makeupar.com/api-console/en/api-keys/
# Leave empty to run fully in mock/demo mode.
YOUCAM_API_KEY=

# Force mock mode even when a key is present (set to 1 for demo rehearsals
# that should not spend API units). Unset or 0 = live when a key exists.
SKINCART_MOCK=
